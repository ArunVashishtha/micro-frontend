					"options": {
						"browserTarget": "container-application:build",
						"extraWebpackConfig": "projects/container-application/webpack.config.js"
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/container-application/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/container-application/src/favicon.ico",
							"projects/container-application/src/assets"
						],
						"styles": [
							"projects/container-application/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		},
